{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "indesign-build-report.schema.json",
  "type": "object",
  "required": ["schema_version", "project_id", "mode", "status", "page_count", "trim_mm", "quality", "source_pages", "outputs", "execution"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["proof", "print"]},
    "status": {"enum": ["compiled", "built"]},
    "page_count": {"type": "integer", "minimum": 1},
    "trim_mm": {
      "type": "array",
      "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
      "minItems": 2,
      "maxItems": 2
    },
    "quality": {
      "type": "object",
      "required": ["minimum_effective_ppi", "print_ready", "blockers"],
      "properties": {
        "minimum_effective_ppi": {"type": "number", "exclusiveMinimum": 0},
        "print_ready": {"type": "boolean"},
        "blockers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "source_pages": {"type": "array", "minItems": 1},
    "outputs": {"type": "object"},
    "execution": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}

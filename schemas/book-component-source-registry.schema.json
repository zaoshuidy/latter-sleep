{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-component-source-registry.schema.json",
  "title": "Book Component Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_mode", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_mode": {"const": "accumulation"},
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_registry_id", "source_type", "title", "source_url", "platform", "collected_at", "publication_year", "publication_year_source_url", "authorization_status"],
        "properties": {
          "source_registry_id": {"type": "string", "pattern": "^SRC-CN-[0-9]{4}$"},
          "source_type": {"enum": ["book", "series"]},
          "title": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "minLength": 1, "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$"},
          "platform": {"type": "string", "minLength": 1},
          "collected_at": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-9]))$"},
          "publication_year": {"type": "integer", "minimum": 2017, "maximum": 2026},
          "publication_year_source_url": {"type": "string", "minLength": 1, "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$"},
          "authorization_status": {"enum": ["accumulation", "confirmed", "archived"]}
        }
      }
    }
  }
}

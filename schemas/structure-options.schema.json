{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-options.schema.json",
  "title": "Memorial Narrative Structure Options",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "options"],
  "properties": {
    "version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "bases", "rationale", "unit_order"],
        "properties": {
          "option_id": {"type": "string", "minLength": 1},
          "bases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["time", "theme", "place", "relationship", "event", "object", "photo", "hybrid"]}
          },
          "rationale": {"type": "string", "minLength": 1},
          "unit_order": {"type": "array", "items": {"type": "string"}},
          "advantages": {"type": "array", "items": {"type": "string"}},
          "risks": {"type": "array", "items": {"type": "string"}},
          "image_opportunities": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toc-brief.schema.json",
  "title": "Designed Table of Contents Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "layout_scope", "entries"],
  "properties": {
    "version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "layout_scope": {"enum": ["single-page", "spread", "multi-page", "to-be-designed"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "source_title", "candidate_title", "source_unit_ids", "confirmation_status"],
        "properties": {
          "entry_id": {"type": "string", "minLength": 1},
          "source_title": {"type": "string"},
          "candidate_title": {"type": "string", "minLength": 1},
          "source_unit_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confirmation_status": {"enum": ["pending", "confirmed", "rejected"]}
        }
      }
    }
  }
}

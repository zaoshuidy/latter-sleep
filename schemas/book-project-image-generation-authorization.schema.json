{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-project-image-generation-authorization.schema.json",
  "title": "Book Project Image Generation Authorization Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "approved_by", "decision", "selection_id", "prompt_id", "component_type", "selection_sha256", "prompt_sha256", "generation_payload_sha256", "retrieval_result_sha256", "fee_action", "output_path", "referenced_images", "approved_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "decision": {"const": "approved"},
    "selection_id": {"type": "string", "minLength": 1},
    "prompt_id": {"type": "string", "minLength": 1},
    "component_type": {"enum": ["cover", "toc", "chapter-opener", "illustration-decoration"]},
    "selection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generation_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retrieval_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fee_action": {"type": "string", "minLength": 1},
    "output_path": {"type": "string", "minLength": 1},
    "referenced_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256", "mime_type"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "mime_type": {"enum": ["image/jpeg", "image/png", "image/webp"]}
        }
      }
    },
    "approved_at": {"type": "string", "format": "date"}
  }
}

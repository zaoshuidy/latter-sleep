{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-component-retrieval-query.schema.json",
  "title": "Book Component Retrieval Query",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_id", "component_type", "field_targets", "selection_policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "query_id": {"type": "string", "minLength": 1},
    "component_type": {"enum": ["cover", "toc", "chapter-opener", "illustration-decoration"]},
    "field_targets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "visual_strategy": {"$ref": "#/$defs/non_empty_strings"},
        "composition": {"$ref": "#/$defs/non_empty_strings"},
        "title_zone": {"$ref": "#/$defs/non_empty_strings"},
        "color": {"$ref": "#/$defs/non_empty_strings"},
        "material": {"$ref": "#/$defs/non_empty_strings"},
        "mood": {"$ref": "#/$defs/non_empty_strings"},
        "cover_scope": {"$ref": "#/$defs/non_empty_strings"},
        "book_category": {"$ref": "#/$defs/non_empty_strings"},
        "opening_mode": {"$ref": "#/$defs/non_empty_strings"},
        "chapter_number_zone": {"$ref": "#/$defs/non_empty_strings"},
        "chapter_title_zone": {"$ref": "#/$defs/non_empty_strings"},
        "image_role": {"$ref": "#/$defs/non_empty_strings"},
        "text_image_relationship": {"$ref": "#/$defs/non_empty_strings"},
        "whitespace": {"$ref": "#/$defs/non_empty_strings"}
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_results", "diversity"],
      "properties": {
        "max_results": {"type": "integer", "minimum": 1, "maximum": 5},
        "diversity": {"enum": ["strict", "balanced", "off"]}
      }
    }
  },
  "$defs": {
    "non_empty_strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

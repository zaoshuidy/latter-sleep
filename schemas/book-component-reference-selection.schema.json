{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-component-reference-selection.schema.json",
  "title": "Book Component Reference Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_id", "query_id", "component_type", "selected_references", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "selection_id": {"type": "string", "minLength": 1},
    "query_id": {"type": "string", "minLength": 1},
    "component_type": {"enum": ["cover", "toc", "chapter-opener", "illustration-decoration"]},
    "selected_references": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "include_fields", "existing_baseline", "adjustment_instruction", "preserve_elements", "required_changes", "exclude_fields"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "include_fields": {"$ref": "#/$defs/non_empty_strings"},
          "existing_baseline": {"type": "string", "minLength": 1},
          "adjustment_instruction": {"type": "string", "minLength": 1},
          "preserve_elements": {"$ref": "#/$defs/non_empty_strings"},
          "required_changes": {"$ref": "#/$defs/non_empty_strings"},
          "exclude_fields": {"$ref": "#/$defs/non_empty_strings"}
        }
      }
    },
    "status": {"enum": ["draft", "approved", "rejected"]}
  },
  "$defs": {
    "non_empty_strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

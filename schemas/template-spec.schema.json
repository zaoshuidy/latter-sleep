{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-spec.schema.json",
  "title": "Fixed Book Template Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "template_id", "fixed_pages", "pages"],
  "properties": {
    "version": {"const": "1.0"},
    "template_id": {"type": "string", "minLength": 1},
    "fixed_pages": {"type": "integer", "minimum": 1},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "family_id", "slots"],
        "properties": {
          "page_number": {"type": "integer", "minimum": 1},
          "family_id": {"type": "string", "minLength": 1},
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot_id", "slot_type", "required"],
              "properties": {
                "slot_id": {"type": "string", "minLength": 1},
                "slot_type": {"enum": ["text", "image"]},
                "required": {"type": "boolean"},
                "source_asset_id": {"type": "string", "minLength": 1},
                "capacity_chars": {"type": "integer", "minimum": 1},
                "aspect_ratio": {"type": "number", "exclusiveMinimum": 0},
                "allow_repeat": {"type": "boolean", "default": false}
              },
              "allOf": [
                {
                  "if": {"properties": {"slot_type": {"const": "text"}}, "required": ["slot_type"]},
                  "then": {"required": ["capacity_chars"]}
                },
                {
                  "if": {"properties": {"slot_type": {"const": "image"}}, "required": ["slot_type"]},
                  "then": {"required": ["aspect_ratio"]}
                }
              ]
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-content-ir.schema.json",
  "title": "BookContentIR",
  "description": "Closed semantic content contract between HTML/Markdown sources and the InDesign body pipeline. CSS, coordinates, and layout hints never enter this record.",
  "type": "object",
  "required": ["schema_version", "source_type", "source_sha256", "blocks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_type": {"enum": ["html", "markdown"]},
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the UTF-8 encoded source string, lowercase hex."
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["type", "text", "attributes"],
      "properties": {
        "type": {
          "enum": [
            "book-title",
            "chapter-title",
            "section-title",
            "body",
            "quote",
            "note",
            "date",
            "signature",
            "image",
            "caption"
          ]
        },
        "text": {"type": "string"},
        "attributes": {
          "type": "object",
          "description": "Only string-valued attributes; images keep src here. CSS and DOM coordinates are never stored.",
          "additionalProperties": {"type": "string"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "image"}}},
          "then": {"properties": {"text": {"type": "string"}}},
          "else": {"properties": {"text": {"minLength": 1}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
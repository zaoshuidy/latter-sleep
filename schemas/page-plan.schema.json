{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "page-plan.schema.json",
  "title": "Book Page Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "page_families", "pages", "overflow_items"],
  "properties": {
    "version": {"const": "1.0"},
    "project_id": {"type": "string"},
    "page_families": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}, "uniqueItems": true},
    "pages": {"type": "array", "items": {"type": "object"}},
    "overflow_items": {"type": "array", "items": {"type": "object"}}
  }
}
